# Copy to .env for local development. Real values live only in the hosting provider (Railway).

# Canonical origin, read at build time: canonical URLs, hreflang, sitemap, Open Graph, host redirect.
# A path (e.g. https://user.github.io/Millimeter-USA) makes the build serve from that base path.
PUBLIC_SITE_URL=http://localhost:4321

# 1 = pre-launch preview build: noindex everywhere, robots.txt disallows all, forms explain that sending opens at launch.
PUBLIC_PREVIEW=

# Transactional email for the contact and careers forms (server only).
RESEND_API_KEY=
CONTACT_TO=info@millimeterbycasanova.com
CONTACT_FROM="MILLIMETER USA <web@millimeterbycasanova.com>"

# Server (optional): defaults to 0.0.0.0:8080
# HOST=0.0.0.0
# PORT=8080
