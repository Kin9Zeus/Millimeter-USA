---
import Base from '../layouts/Base.astro';
import MediaHero from '../components/MediaHero.astro';
import { HERO } from '../data/media';
import Form from '../components/Form.astro';
import Arrow from '../components/Arrow.astro';
import { t, CONTACT, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const all = t(lang);
const d = all.contactPage;
---
<Base lang={lang} page="contact" crumb={all.nav.contact}>
  <MediaHero image={HERO.contact} seq="contact" eyebrow={d.eyebrow} title={d.title} intro={d.intro} measure={all.common.reply} run="45svh" runPortrait="35svh" pos="60% 50%" />
  <section class="contact on-light section" aria-labelledby="form-title">
    <div class="wrap contact__grid">
      <div class="contact__form">
        <h2 id="form-title" class="display h-2">{d.formTitle}</h2>
        <Form lang={lang} kind="contact" />
      </div>
      <aside class="contact__side">
        <div class="side-block">
          <h3 class="side-h">{d.directTitle}</h3>
          <a class="side-big display" href={CONTACT.whatsappLink(all.common.whatsappText)} target="_blank" rel="noopener">WhatsApp<Arrow dir="up-right" /></a>
          <p class="mono">{CONTACT.whatsappDisplay}</p>
          <a class="text-link" href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
          <a class="text-link" href={CONTACT.instagram} target="_blank" rel="noopener">Instagram {CONTACT.instagramHandle}</a>
          <p class="muted">{d.hq}</p>
        </div>
        <div class="side-block">
          <h3 class="side-h">{d.helpsTitle}</h3>
          <ul role="list" class="side-list">{d.helps.map((h) => <li>{h}</li>)}</ul>
        </div>
        <div class="side-block">
          <h3 class="side-h">{d.nextTitle}</h3>
          <p>{d.nextBody}</p>
        </div>
      </aside>
    </div>
  </section>
</Base>

<style>
  .contact__grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); gap: clamp(2.5rem, 6vw, 7rem); }
  .contact__form { display: grid; gap: 2.5rem; align-content: start; }
  .contact__side { display: grid; gap: 2.5rem; align-content: start; }
  .side-block { display: grid; gap: 0.6rem; justify-items: start; padding-top: 1.25rem; border-top: 1px solid var(--line); }
  .side-h { font-size: var(--fs-xs); letter-spacing: 0.18em; text-transform: uppercase; color: var(--copper-deep); font-weight: 500; }
  .side-big { display: inline-flex; align-items: center; gap: 0.75rem; font-size: var(--fs-2xl); line-height: 1; }
  .side-big svg { width: 1.25rem; }
  .side-big:hover { color: var(--copper-deep); }
  .side-list { display: grid; gap: 0.5rem; }
  .side-list li::before { content: '— '; color: var(--copper-deep); }
  @media (max-width: 900px) { .contact__grid { grid-template-columns: 1fr; } }
</style>
