---
// Custom 404 (trilingual: English first, Spanish and Arabic below). Served with status 404 by the Node adapter.
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import { HERO } from '../data/media';
import { t, ROUTES, CONTACT, type PageId } from '../i18n';
const en = t('en');
const es = t('es');
const ar = t('ar');
const pages: PageId[] = ['home', 'technology', 'applications', 'materials', 'projects', 'casanova', 'contact', 'careers'];
const label = (id: PageId, lang: 'en' | 'es') => (id === 'home' ? t(lang).nav.home : t(lang).nav[id as keyof typeof en.nav]);
---
<Base lang="en" page="notFound" noindex>
  <section class="nf on-dark">
    <div class="nf__bg" aria-hidden="true">
      <Image src={HERO.home} alt="" widths={[960, 1600]} sizes="100vw" quality={60} loading="eager" />
    </div>
    <div class="wrap nf__grid">
      <div class="nf__copy">
        <p class="eyebrow">{en.notFound.eyebrow}</p>
        <p class="nf__read mono" aria-hidden="true"><span>{en.common.thickness}</span> 0.0 mm</p>
        <h1 class="display h-hero">{en.notFound.title[0]}<br /><em>{en.notFound.title[1]}</em></h1>
        <p class="lede">{en.notFound.body}</p>
        <p class="nf__es" lang="es">{es.notFound.title.join(' ')} {es.notFound.body}</p>
        <p class="nf__es nf__ar" lang="ar" dir="rtl">{ar.notFound.title.join(' ')} {ar.notFound.body}</p>
        <a class="btn" href={ROUTES.home.en}>{en.nav.home}<Arrow /></a>
      </div>
      <nav class="nf__nav" aria-label={en.notFound.listTitle}>
        <p class="nf__h">{en.notFound.listTitle} <span lang="es">/ {es.notFound.listTitle}</span> <span lang="ar">/ {ar.notFound.listTitle}</span></p>
        <ul role="list">
          {pages.map((id) => (
            <li>
              <a href={ROUTES[id].en}>{label(id, 'en')}</a>
              <span class="nf__alts"><a href={ROUTES[id].es} lang="es" class="nf__alt">ES</a> <a href={ROUTES[id].ar} lang="ar" class="nf__alt" title="العربية">ع</a></span>
            </li>
          ))}
        </ul>
        <p class="nf__report">{en.notFound.report} <a class="text-link" href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></p>
      </nav>
    </div>
  </section>
</Base>

<style>
  .nf { position: relative; min-height: 100svh; display: flex; align-items: center; padding-top: calc(var(--header-h) + 3rem); padding-bottom: 4rem; overflow: hidden; }
  .nf__bg { position: absolute; inset: 0; opacity: 0.35; }
  .nf__bg :global(img) { width: 100%; height: 100%; object-fit: cover; filter: grayscale(0.4); }
  .nf__bg::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, var(--ink) 30%, rgba(18,16,13,.6)); }
  .nf__grid { position: relative; display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); gap: clamp(2.5rem, 6vw, 6rem); align-items: end; }
  .nf__copy { display: grid; gap: 1.5rem; justify-items: start; }
  .nf__copy h1 em { color: var(--copper); }
  .nf__read { display: flex; gap: 1rem; align-items: baseline; font-size: var(--fs-xl); color: var(--copper); border-bottom: 1px solid var(--copper); padding-bottom: 0.4rem; }
  .nf__read span { font-size: var(--fs-xs); letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted-dark); font-family: var(--f-body); }
  .nf__es { color: var(--muted-dark); font-size: var(--fs-sm); max-width: 50ch; font-style: italic; }
  .nf__ar { font-style: normal; text-align: right; }
  .nf__nav { display: grid; gap: 1rem; }
  .nf__h { font-size: var(--fs-xs); letter-spacing: 0.18em; text-transform: uppercase; color: var(--copper); }
  .nf__nav li { display: flex; justify-content: space-between; gap: 1rem; padding-block: 0.6rem; border-bottom: 1px solid var(--line-dark); }
  .nf__nav li a:hover { color: var(--copper); }
  .nf__alt { color: var(--muted-dark); font-size: var(--fs-sm); }
  .nf__report { font-size: var(--fs-sm); color: var(--muted-dark); }
  @media (max-width: 900px) { .nf__grid { grid-template-columns: 1fr; } }
</style>
