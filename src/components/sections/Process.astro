---
import { Image } from 'astro:assets';
import { MISC } from '../../data/media';
import { t, type Lang } from '../../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang).process;
---
<section class="process on-dark section cv" aria-labelledby="process-title">
  <div class="wrap process__grid">
    <div class="process__main">
      <div class="process__head">
        <p class="eyebrow">{d.eyebrow}</p>
        <h2 id="process-title" class="display h-2" data-split>{d.title}</h2>
      </div>
      <!-- A real sequence, so the steps are numbered. -->
      <ol class="steps" role="list">
        {d.steps.map((s, i) => (
          <li class="step" data-reveal style={`--d:${i * 0.1}s`}>
            <span class="step__n mono">{String(i + 1).padStart(2, '0')}</span>
            <span class="step__line" aria-hidden="true"></span>
            <h3 class="step__t">{s.t}</h3>
            <p class="step__d">{s.d}</p>
          </li>
        ))}
      </ol>
      <p class="process__honest display">{d.honest}</p>
    </div>

    <!-- Finished piece (client correction #16): what the four steps end in. -->
    <figure class="process__piece">
      <div class="process__media media" data-reveal="clip">
        <Image src={MISC.closetIsland} alt={d.imageAlt} widths={[480, 720, 1086]} sizes="(max-width: 900px) 100vw, 34vw" quality={78} data-parallax="0.05" />
      </div>
      <figcaption class="process__cap mono">{d.imageCaption}</figcaption>
    </figure>
  </div>
</section>

<style>
  .process__grid { display: grid; grid-template-columns: minmax(0, 8fr) minmax(0, 4fr); gap: clamp(2.5rem, 5vw, 5.5rem); align-items: start; }
  .process__head { display: grid; gap: 1.25rem; max-width: 40rem; }
  .steps { margin-top: clamp(3rem, 6vw, 5rem); display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2.5rem var(--gutter); }
  .step { display: grid; gap: 0.9rem; align-content: start; }
  .step__n { color: var(--copper); font-size: var(--fs-sm); }
  .step__line { height: 1px; background: var(--copper); position: relative; }
  .step__line::after { content: ''; position: absolute; inset-inline-end: 0; top: -3px; width: 7px; height: 7px; border-top: 1px solid var(--copper); border-right: 1px solid var(--copper); transform: rotate(45deg); }
  :global([dir='rtl']) .step__line::after { transform: rotate(-135deg); }
  .step:last-child .step__line::after { display: none; }
  .step__t { font-size: var(--fs-lg); font-weight: 600; }
  .step__d { color: var(--muted-dark); font-size: var(--fs-sm); }
  .process__honest { margin-top: clamp(3rem, 6vw, 5rem); font-size: var(--fs-xl); font-style: italic; max-width: 34ch; color: color-mix(in srgb, var(--text-dark) 90%, transparent); }
  .process__piece { position: sticky; top: calc(var(--header-h) + 2rem); display: grid; gap: 0.85rem; }
  .process__media { aspect-ratio: 3 / 4; }
  .process__media :global(img) { position: absolute; inset: -5% 0; width: 100%; height: 110%; object-fit: cover; object-position: 50% 50%; }
  .process__cap { font-size: var(--fs-xs); color: var(--copper); }
  @media (max-width: 1100px) { .process__grid { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); } }
  @media (max-width: 900px) {
    .process__grid { grid-template-columns: 1fr; }
    .process__piece { position: static; max-width: 32rem; }
  }
  @media (max-width: 520px) { .steps { grid-template-columns: 1fr; } }
</style>
