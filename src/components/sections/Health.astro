---
import { t, type Lang } from '../../i18n';
interface Props { lang: Lang; withTable?: boolean }
const { lang, withTable = false } = Astro.props;
const d = t(lang).health;
---
<section class="health on-light section cv" id="health" aria-labelledby="health-title">
  <div class="wrap">
    <div class="health__head">
      <p class="eyebrow">{d.eyebrow}</p>
      <h2 id="health-title" class="display h-1" data-split>{d.title}</h2>
      <p class="health__body">{d.body}</p>
    </div>

    <div class="cmp">
      <article class="cmp__card">
        <p class="cmp__label">{d.quartzLabel}</p>
        <p class="cmp__value display">{d.quartzValue}</p>
        <div class="cmp__dots" aria-hidden="true" style="--n: 40"></div>
        <p class="cmp__note">{d.quartzNote}</p>
      </article>
      <article class="cmp__card cmp__card--mm">
        <p class="cmp__label">{d.mmLabel}</p>
        <p class="cmp__value display">{d.mmValue}</p>
        <div class="cmp__dots cmp__dots--half" aria-hidden="true" style="--n: 0"></div>
        <p class="cmp__note">{d.mmNote}</p>
      </article>
    </div>

    <ul class="health__points" role="list">
      {d.points.map((p, i) => <li data-reveal style={`--d:${i * 0.07}s`}>{p}</li>)}
    </ul>

    {withTable && (
      <div class="tbl-wrap">
        <table class="tbl">
          <caption>{d.table.caption}</caption>
          <thead><tr><th scope="col"></th><th scope="col">{d.quartzLabel}</th><th scope="col">MILLIMETER</th></tr></thead>
          <tbody>{d.table.rows.map((r) => <tr><th scope="row">{r[0]}</th><td>{r[1]}</td><td class="tbl__mm">{r[2]}</td></tr>)}</tbody>
        </table>
      </div>
    )}

    <p class="health__src muted">{d.note}</p>
  </div>
</section>

<style>
  .health__head { display: grid; gap: 1.5rem; max-width: 52rem; }
  .health__body { font-size: var(--fs-lg); max-width: 50ch; }
  .cmp { margin-top: clamp(3rem, 6vw, 5rem); display: grid; grid-template-columns: 1fr 1fr; gap: var(--gutter); }
  .cmp__card { background: var(--sand); padding: clamp(1.5rem, 3vw, 2.75rem); border-top: 1px solid #b9ad9b; display: grid; gap: 1.1rem; align-content: start; }
  .cmp__card--mm { border-top-color: var(--copper-deep); }
  .cmp__label { font-size: var(--fs-xs); letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted); }
  .cmp__value { font-size: var(--fs-3xl); line-height: 0.9; }
  .cmp__card--mm .cmp__value { color: var(--copper-deep); }
  /* 100-dot grid (20 × 5) drawn with gradients: first --n dots filled = silica share. */
  .cmp__dots { --d: 1.1rem; position: relative; width: calc(var(--d) * 20); max-width: 100%; aspect-ratio: 4 / 1;
    background: radial-gradient(circle at center, rgba(18,16,13,.13) 0 34%, transparent 36%) 0 0 / var(--d) var(--d); }
  .cmp__dots::before { content: ''; position: absolute; left: 0; top: 0; height: calc(var(--d) * 2); width: 100%;
    background: radial-gradient(circle at center, var(--ink) 0 34%, transparent 36%) 0 0 / var(--d) var(--d); }
  .cmp__dots[style*='--n: 0']::before { width: calc(var(--d) * 0.5); height: var(--d); background: radial-gradient(circle at right center, var(--copper-deep) 0 34%, transparent 36%) 0 0 / var(--d) var(--d); }
  .cmp__note { color: var(--muted); max-width: 40ch; }
  .health__points { margin-top: 2.5rem; display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--gutter); }
  .health__points li { border-left: 1px solid var(--copper-deep); padding-left: 1rem; font-weight: 600; }
  .tbl-wrap { margin-top: 3rem; overflow-x: auto; }
  .tbl { width: 100%; border-collapse: collapse; min-width: 34rem; }
  .tbl caption { text-align: left; font-size: var(--fs-xs); letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); padding-bottom: 1rem; }
  .tbl th, .tbl td { text-align: left; padding: 1rem 1rem 1rem 0; border-top: 1px solid var(--line); }
  .tbl thead th { font-size: var(--fs-xs); letter-spacing: 0.14em; text-transform: uppercase; font-weight: 500; color: var(--muted); }
  .tbl tbody th { font-weight: 500; }
  .tbl__mm { color: var(--copper-deep); font-weight: 600; }
  .health__src { margin-top: 2rem; font-size: var(--fs-xs); }
  @media (max-width: 900px) { .cmp { grid-template-columns: 1fr; } .health__points { grid-template-columns: 1fr 1fr; } }
</style>
