---
import Logo from './Logo.astro';
import { t, ROUTES, CONTACT, LANGS, LOCALE, LANG_NAME, type Lang, type NavId } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const r = (id: keyof typeof ROUTES) => ROUTES[id][lang];
const explore: NavId[] = ['technology', 'applications', 'materials', 'projects', 'casanova', 'careers'];
const year = new Date().getFullYear();
---
<footer class="ftr on-dark cv" aria-labelledby="ftr-title">
  <h2 id="ftr-title" class="sr-only">MILLIMETER by Casanova</h2>
  <div class="wrap">
    <div class="ftr__top">
      <div class="ftr__brand">
        <a class="ftr__logo" href={r('home')} aria-label={`MILLIMETER by Casanova — ${d.nav.home}`}><Logo decorative /></a>
        <p class="ftr__tag">{d.footer.tagline}</p>
        <a class="ftr__cta" href={r('contact')}>
          <span>{d.common.talk}</span>
          <svg width="28" height="8" viewBox="0 0 28 8" fill="none" aria-hidden="true"><path d="M0 4h26M22 1l4 3-4 3" stroke="currentColor" stroke-width="1" /></svg>
        </a>
      </div>

      <nav class="ftr__col" aria-label={d.footer.explore}>
        <h3 class="ftr__h">{d.footer.explore}</h3>
        <ul role="list">
          {explore.map((id) => <li><a href={r(id)}>{d.nav[id]}</a></li>)}
          <li><a href={r('contact')}>{d.nav.contact}</a></li>
        </ul>
      </nav>

      <div class="ftr__col">
        <h3 class="ftr__h">{d.footer.contact}</h3>
        <ul role="list">
          <li><a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></li>
          <li><a href={CONTACT.whatsappLink(d.common.whatsappText)} target="_blank" rel="noopener">WhatsApp {CONTACT.whatsappDisplay} <span aria-hidden="true">↗</span></a></li>
          <li><a href={CONTACT.instagram} target="_blank" rel="me noopener">Instagram {CONTACT.instagramHandle} <span aria-hidden="true">↗</span></a></li>
          <li><a href={CONTACT.corporate} target="_blank" rel="noopener">millimeterbycasanova.com <span aria-hidden="true">↗</span></a></li>
        </ul>
        <p class="ftr__note">{d.footer.hq}</p>
      </div>

      <div class="ftr__col">
        <h3 class="ftr__h">{d.footer.legal}</h3>
        <ul role="list">
          <li><a href={r('privacy')}>{d.footer.privacy}</a></li>
          <li><a href={r('cookies')}>{d.footer.cookies}</a></li>
          <li><a href={CONTACT.southAmerica} target="_blank" rel="noopener">MILLIMETER {d.footer.southAmerica} <span aria-hidden="true">↗</span></a></li>
        </ul>
      </div>
    </div>

    <div class="ftr__bottom">
      <p>© {year} {CONTACT.company} · {d.footer.rights}</p>
      <p class="ftr__langs" role="group" aria-label={d.nav.language}>
        {LANGS.map((l) => <a href={ROUTES.home[l]} hreflang={LOCALE[l]} lang={l} aria-current={l === lang ? 'true' : undefined}>{LANG_NAME[l]}</a>)}
      </p>
      <button type="button" class="ftr__motion" data-motion-toggle data-on={d.footer.motionOn} data-off={d.footer.motionOff} aria-label={d.footer.motionHint} hidden>
        {d.footer.motion}: <span data-motion-state></span>
      </button>
    </div>
  </div>
</footer>

<style>
  .ftr { padding-block: clamp(3.5rem, 8vh, 6rem) 2rem; border-top: 1px solid var(--line-dark); }
  .ftr__top { display: grid; grid-template-columns: 1.6fr repeat(3, 1fr); gap: 2.5rem; }
  .ftr__logo { display: block; width: clamp(9rem, 14vw, 12rem); color: var(--text-dark); margin-bottom: 1.25rem; }
  .ftr__tag { font-family: var(--f-display); font-style: italic; font-size: var(--fs-lg); color: color-mix(in srgb, var(--text-dark) 80%, transparent); max-width: 24ch; }
  .ftr__cta { display: inline-flex; align-items: center; gap: 0.9rem; margin-top: 1.5rem; font-size: var(--fs-xs); font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--copper); }
  .ftr__cta svg { transition: transform 0.4s var(--ease); }
  .ftr__cta:hover svg { transform: translateX(5px); }
  .ftr__h { font-family: var(--f-mono); font-size: 0.6875rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--copper); font-weight: 400; margin-bottom: 1.1rem; }
  .ftr__col ul { display: grid; gap: 0.55rem; font-size: var(--fs-sm); }
  .ftr__col a { color: color-mix(in srgb, var(--text-dark) 78%, transparent); transition: color 0.3s; overflow-wrap: anywhere; }
  .ftr__col a:hover { color: var(--text-dark); }
  .ftr__note { margin-top: 1rem; font-size: var(--fs-xs); color: var(--muted-dark); }
  .ftr__bottom { margin-top: 3.5rem; padding-top: 1.5rem; border-top: 1px solid var(--line-dark); display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1rem 2rem; font-size: var(--fs-xs); color: var(--muted-dark); letter-spacing: 0.04em; }
  .ftr__langs { display: flex; gap: 1.1rem; }
  .ftr__langs a:hover, .ftr__langs a[aria-current='true'] { color: var(--copper); }
  .ftr__motion { font-family: var(--f-mono); font-size: var(--fs-xs); color: var(--muted-dark); padding: 0.4rem 0; letter-spacing: 0.06em; }
  .ftr__motion:hover { color: var(--copper); }
  .ftr__motion span { color: var(--text-dark); }
  @media (max-width: 1000px) { .ftr__top { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .ftr__top { grid-template-columns: 1fr; } }
</style>

<script>
  // Footer switch: stores the visitor's choice and reloads (the animated and still versions differ).
  const btn = document.querySelector<HTMLButtonElement>('[data-motion-toggle]');
  if (btn) {
    const root = document.documentElement;
    const state = btn.querySelector('[data-motion-state]')!;
    const on = root.dataset.motion === 'on' || root.dataset.motionFailsafe === '1';
    state.textContent = on ? btn.dataset.on! : btn.dataset.off!;
    btn.setAttribute('aria-pressed', String(on));
    btn.hidden = false;
    btn.addEventListener('click', () => {
      try { localStorage.setItem('mm-motion', on ? 'off' : 'on'); } catch {}
      const u = new URL(location.href); u.searchParams.delete('motion');
      location.replace(u.toString());
    });
  }
</script>
