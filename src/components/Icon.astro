---
// Contact and social glyphs, 24×24, drawn to share one stroke weight so the footer reads as a single set.
// Brand marks (WhatsApp, Instagram, Pinterest) are simplified single-colour outlines; colour comes from currentColor.
interface Props { name: 'mail' | 'whatsapp' | 'instagram' | 'pinterest' | 'web'; size?: number }
const { name, size = 18 } = Astro.props;
---
<svg class="icon" width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
  {name === 'mail' && (<><rect x="3" y="5.5" width="18" height="13" rx="1.5" /><path d="M3.5 6.5 12 13l8.5-6.5" /></>)}
  {name === 'whatsapp' && (<><path d="M3.6 20.4 5 15.8A8.6 8.6 0 1 1 8.4 19l-4.8 1.4Z" /><path d="M9.1 8.3c.2-.4.5-.5.8-.5h.5c.2 0 .4.1.5.4l.7 1.7c.1.3 0 .5-.1.7l-.5.6c.6 1.2 1.6 2.1 2.8 2.7l.6-.6c.2-.2.5-.2.7-.1l1.6.8c.3.1.4.3.4.6v.4c0 .4-.2.8-.6 1-.6.3-1.4.4-2.4.1-2.3-.8-4.3-2.7-5.2-5-.3-.9-.2-1.8.2-2.8Z" fill="currentColor" stroke="none" /></>)}
  {name === 'instagram' && (<><rect x="3.5" y="3.5" width="17" height="17" rx="4.5" /><circle cx="12" cy="12" r="3.9" /><circle cx="17.2" cy="6.8" r="0.9" fill="currentColor" stroke="none" /></>)}
  {name === 'pinterest' && (<><circle cx="12" cy="12" r="8.5" /><path d="M10.6 20.2 12.4 13M10.9 13.4c.4 1 1.3 1.5 2.3 1.4 2-.2 3.3-2.1 3.1-4.4-.2-2.3-2.2-3.8-4.6-3.7-2.6.1-4.4 2-4.3 4.3 0 .9.4 1.7 1 2.1" /></>)}
  {name === 'web' && (<><circle cx="12" cy="12" r="8.5" /><path d="M3.5 12h17M12 3.5c2.3 2.4 3.4 5.2 3.4 8.5s-1.1 6.1-3.4 8.5c-2.3-2.4-3.4-5.2-3.4-8.5s1.1-6.1 3.4-8.5Z" /></>)}
</svg>

<style>
  .icon { flex: none; display: inline-block; vertical-align: middle; }
</style>
