---
// Contact and careers forms. Works without JS (classic POST → redirect back with ?sent=1),
// and is enhanced with fetch + inline validation when JS is available.
import Arrow from './Arrow.astro';
import { t, ROUTES, asset, type Lang } from '../i18n';
interface Props { lang: Lang; kind: 'contact' | 'careers' }
const { lang, kind } = Astro.props;
const all = t(lang);
const f = all.form;
const c = all.careersPage;
const action = asset(kind === 'contact' ? '/api/contact' : '/api/careers');
const privacy = ROUTES.privacy[lang];
const consentText = kind === 'contact' ? f.consent : c.consent;
// Static preview (GitHub Pages) has no API: the form validates but explains that sending opens at launch.
const preview = import.meta.env.PUBLIC_PREVIEW === '1'
  ? { en: 'Preview: online sending opens at launch. Meanwhile, reach us on WhatsApp or by email.', es: 'Vista previa: el envío en línea se activa al publicar. Mientras tanto, escríbenos por WhatsApp o email.', fr: 'Aperçu : l’envoi en ligne sera activé au lancement. En attendant, écrivez-nous sur WhatsApp ou par e-mail.' }[lang]
  : undefined;
const consentParts = consentText.split(kind === 'contact' ? f.consentLink : ({ en: 'privacy policy', es: 'política de privacidad', fr: 'politique de confidentialité' }[lang]));
---
<form class="form" method="post" action={action} enctype={kind === 'careers' ? 'multipart/form-data' : 'application/x-www-form-urlencoded'} novalidate data-form={kind}
  data-msg-invalid={f.errorInvalid} data-msg-preview={preview} data-msg-generic={f.errorGeneric} data-msg-rate={f.errorRate} data-msg-sending={f.sending}>
  <input type="hidden" name="lang" value={lang} />
  <input type="hidden" name="ts" value="" data-ts />
  <div class="hp" aria-hidden="true">
    <label for={`${kind}-website`}>{f.honeypot}</label>
    <input id={`${kind}-website`} name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <div class="form__grid">
    <div class="field">
      <label for={`${kind}-name`}>{f.name} <span aria-hidden="true">*</span></label>
      <input class="input" id={`${kind}-name`} name="name" type="text" autocomplete="name" required maxlength="120" aria-describedby={`${kind}-name-err`} />
      <p class="field-error" id={`${kind}-name-err`} data-err="name" data-msg={f.errors.name}></p>
    </div>
    <div class="field">
      <label for={`${kind}-email`}>{f.email} <span aria-hidden="true">*</span></label>
      <input class="input" id={`${kind}-email`} name="email" type="email" autocomplete="email" inputmode="email" required maxlength="160" aria-describedby={`${kind}-email-err`} />
      <p class="field-error" id={`${kind}-email-err`} data-err="email" data-msg={f.errors.email}></p>
    </div>

    {kind === 'contact' ? (
      <>
        <div class="field">
          <label for="contact-phone">{f.phone}<span class="opt">{f.optional}</span></label>
          <input class="input" id="contact-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" maxlength="40" />
        </div>
        <div class="field">
          <label for="contact-company">{f.company}<span class="opt">{f.optional}</span></label>
          <input class="input" id="contact-company" name="company" type="text" autocomplete="organization" maxlength="160" />
        </div>
        <div class="field">
          <label for="contact-location">{f.location}<span class="opt">{f.optional}</span></label>
          <input class="input" id="contact-location" name="location" type="text" autocomplete="address-level2" maxlength="120" />
        </div>
        <div class="field">
          <label for="contact-role">{f.role}<span class="opt">{f.optional}</span></label>
          <select class="input" id="contact-role" name="role">
            <option value="">—</option>
            {f.roles.map((r) => <option value={r}>{r}</option>)}
          </select>
        </div>
        <div class="field field--full">
          <label for="contact-message">{f.message} <span aria-hidden="true">*</span></label>
          <textarea class="input" id="contact-message" name="message" required minlength="10" maxlength="5000" placeholder={f.messageHint} aria-describedby="contact-message-err"></textarea>
          <p class="field-error" id="contact-message-err" data-err="message" data-msg={f.errors.message}></p>
        </div>
      </>
    ) : (
      <>
        <div class="field">
          <label for="careers-location">{c.country}<span class="opt">{f.optional}</span></label>
          <input class="input" id="careers-location" name="location" type="text" autocomplete="address-level2" maxlength="120" />
        </div>
        <div class="field">
          <label for="careers-area">{c.area}<span class="opt">{f.optional}</span></label>
          <select class="input" id="careers-area" name="area">
            <option value="">—</option>
            {c.areas.map((r) => <option value={r}>{r}</option>)}
          </select>
        </div>
        <div class="field field--full">
          <label for="careers-message">{c.about}<span class="opt">{f.optional}</span></label>
          <textarea class="input" id="careers-message" name="message" maxlength="3000"></textarea>
        </div>
        <div class="field field--full">
          <label for="careers-cv">{c.cv} <span aria-hidden="true">*</span></label>
          <input class="input input--file" id="careers-cv" name="cv" type="file" accept="application/pdf,.pdf" required aria-describedby="careers-cv-hint careers-cv-err" />
          <p class="muted field-hint" id="careers-cv-hint">{c.cvHint}</p>
          <p class="field-error" id="careers-cv-err" data-err="cv" data-msg={f.errors.cv}></p>
        </div>
      </>
    )}

    <div class="field field--full">
      <label class="check">
        <input type="checkbox" name="consent" value="yes" required aria-describedby={`${kind}-consent-err`} />
        <span>{consentParts[0]}<a class="text-link" href={privacy} target="_blank" rel="noopener">{kind === 'contact' ? f.consentLink : ({ en: 'privacy policy', es: 'política de privacidad', fr: 'politique de confidentialité' }[lang])}</a>{consentParts[1]} *</span>
      </label>
      <p class="field-error" id={`${kind}-consent-err`} data-err="consent" data-msg={f.errors.consent}></p>
    </div>
  </div>

  <div class="form__foot">
    <button class="btn" type="submit" data-submit>{kind === 'contact' ? f.submit : c.submit}<Arrow /></button>
    <p class="form__status" role="status" aria-live="polite" data-status></p>
  </div>

  <div class="form__done" data-done hidden tabindex="-1">
    <p class="display form__done-t">{kind === 'contact' ? f.successTitle : c.successTitle}</p>
    <p>{kind === 'contact' ? f.successBody : c.successBody}</p>
  </div>
</form>

<style>
  .form { position: relative; display: grid; gap: 2rem; }
  .form__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.75rem var(--gutter); }
  .field--full { grid-column: 1 / -1; }
  .field-hint { font-size: var(--fs-xs); }
  .input--file { padding: 0.75rem 0; font-size: var(--fs-sm); }
  .input--file::file-selector-button { margin-right: 1rem; padding: 0.55rem 0.9rem; border: 1px solid var(--line); background: transparent; color: inherit; font: inherit; font-size: var(--fs-xs); letter-spacing: 0.12em; text-transform: uppercase; cursor: pointer; }
  .form__foot { display: flex; flex-wrap: wrap; align-items: center; gap: 1.25rem; }
  .form__status { font-size: var(--fs-sm); color: var(--muted); }
  .form__status.is-error { color: #e2786c; }
  .form__done { padding: 2rem; border: 1px solid var(--accent); display: grid; gap: 0.75rem; }
  .form__done-t { font-size: var(--fs-2xl); color: var(--accent); }
  :global(.form.is-done) .form__grid, :global(.form.is-done) .form__foot { display: none; }
  @media (max-width: 620px) { .form__grid { grid-template-columns: 1fr; } }
</style>

<script>
  document.querySelectorAll<HTMLFormElement>('form[data-form]').forEach((form) => {
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const done = form.querySelector<HTMLElement>('[data-done]')!;
    const ts = form.querySelector<HTMLInputElement>('[data-ts]');
    if (ts) ts.value = String(Date.now());
    if (new URLSearchParams(location.search).get('sent') === '1') { form.classList.add('is-done'); done.hidden = false; }

    const setErr = (name: string, on: boolean) => {
      const p = form.querySelector<HTMLElement>(`[data-err="${name}"]`);
      const input = form.querySelector<HTMLInputElement>(`[name="${name}"]`);
      if (p) p.textContent = on ? p.dataset.msg || '' : '';
      input?.setAttribute('aria-invalid', String(on));
    };
    const validate = () => {
      let first: HTMLElement | null = null;
      const check = (name: string, ok: boolean) => { setErr(name, !ok); if (!ok && !first) first = form.querySelector(`[name="${name}"]`); };
      const v = (n: string) => (form.elements.namedItem(n) as HTMLInputElement | null);
      check('name', !!v('name')?.value.trim());
      check('email', /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v('email')?.value.trim() || ''));
      if (form.dataset.form === 'contact') check('message', (v('message')?.value.trim().length || 0) >= 10);
      if (form.dataset.form === 'careers') {
        const file = (v('cv') as HTMLInputElement | null)?.files?.[0];
        check('cv', !!file && file.size <= 5 * 1024 * 1024 && /\.pdf$/i.test(file.name));
      }
      check('consent', !!(v('consent') as HTMLInputElement | null)?.checked);
      return first as HTMLElement | null;
    };
    form.addEventListener('input', (e) => { const n = (e.target as HTMLInputElement).name; if ((e.target as HTMLElement).getAttribute('aria-invalid') === 'true') setErr(n, false); });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const bad = validate();
      if (bad) { status.textContent = form.dataset.msgInvalid || ''; status.classList.add('is-error'); bad.focus(); return; }
      status.classList.remove('is-error');
      if (form.dataset.msgPreview) { status.textContent = form.dataset.msgPreview; return; }
      status.textContent = form.dataset.msgSending || '';
      submit.disabled = true;
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        if (res.ok) {
          form.classList.add('is-done'); done.hidden = false; done.focus(); status.textContent = '';
          return;
        }
        status.classList.add('is-error');
        status.textContent = res.status === 429 ? form.dataset.msgRate || '' : form.dataset.msgGeneric || '';
        if (res.status === 400) {
          const j = await res.json().catch(() => ({}));
          (j.fields || []).forEach((n: string) => setErr(n, true));
        }
      } catch {
        status.classList.add('is-error');
        status.textContent = form.dataset.msgGeneric || '';
      } finally {
        submit.disabled = false;
      }
    });
  });
</script>
