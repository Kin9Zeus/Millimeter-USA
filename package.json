{
  "name": "millimeter-usa",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MILLIMETER by Casanova — global website: Astro, GSAP scroll-driven video, EN/ES/AR (RTL), Node on Railway.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/compress.mjs",
    "preview": "node server.mjs",
    "start": "node server.mjs",
    "check": "astro check",
    "media": "python -I scripts/process-media.py",
    "frames": "python -I scripts/video-frames.py",
    "build:pages": "astro build && node scripts/pages-prepare.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.7",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource/noto-naskh-arabic": "^5.2.8",
    "astro": "^7.3.8",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^24.19.2",
    "topojson-client": "^3.1.0",
    "typescript": "^6.0.0",
    "world-atlas": "^2.0.2"
  }
}
